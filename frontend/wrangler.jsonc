{
  "name": "synapse-pm",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./worker.js",
  "vars": {
    "API_ORIGIN": "https://api.synapsepm.us.ci"
  },
  "assets": {
    "directory": "./user",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
